#!/bin/sh
# Refuse replacement beneath live processes; never kill the player's game.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
if [ "${3:-/}" != / ]; then
    echo "Clumsier must be installed on the running system volume." >&2
    exit 1
fi
if ps -axo comm= | grep -E '(/Clumsier$|/clumsier-lag-helper$|/macos_lag_helper.py$)' >/dev/null; then
    echo 'Quit Clumsier and wait 70 seconds for the network helper to exit before installing/updating.' >&2
    exit 1
fi
for directory in '/Library/Application Support' '/Library/Application Support/Clumsier' '/Library/Application Support/Clumsier/Helper'; do
    if [ -e "$directory" ] || [ -L "$directory" ]; then
        [ ! -L "$directory" ] && [ -d "$directory" ] || { echo 'Unsafe helper install location.' >&2; exit 1; }
        test "$(stat -f %u "$directory")" = 0 || { echo 'Helper parent must be root-owned.' >&2; exit 1; }
        mode=$(stat -f %Lp "$directory")
        test "$((0$mode & 0022))" = 0 || { echo 'Helper parent is writable by another user.' >&2; exit 1; }
    fi
done

for socket in /var/run/clumsier-lag-*.sock; do
    if [ -e "$socket" ] || [ -L "$socket" ]; then
        echo "Helper endpoint still exists: $socket. Resolve cleanup before installation." >&2
        exit 1
    fi
done
if [ -L /Applications/Clumsier.app ] || [ -L '/Applications/Uninstall Clumsier.app' ]; then
    echo 'Refusing installation over an app symlink.' >&2
    exit 1
fi
